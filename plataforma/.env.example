# Copie para .env.local (NUNCA suba o .env.local para o GitHub) e preencha.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
# Chave de serviço: SÓ no servidor (Vercel > Environment Variables). Nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Único e-mail autorizado a entrar na plataforma
DONO_EMAIL=voce@exemplo.com

# brapi.dev (cotações da bolsa brasileira): token gratuito em https://brapi.dev
BRAPI_TOKEN=

# Segredo que protege as rotas de cron (gere um texto longo e aleatório)
CRON_SECRET=
